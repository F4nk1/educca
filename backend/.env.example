# ==============================================================================
# Educca Backend - Variables de Entorno de Ejemplo
# Copia este archivo a 'backend/.env' y edita los valores para tu entorno local.
# ==============================================================================

# Configuración del Servidor HTTP
APP_ENV=development
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=educca
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable

# Secretos Criptográficos (JWT y QR Dinámico)
ACCESS_SECRET=super_secret_jwt_access_key_change_in_prod
REFRESH_SECRET=super_secret_jwt_refresh_key_change_in_prod
QR_SECRET=super_secret_qr_hmac_key_change_in_prod
QR_TTL_SECONDS=300

# Normativa LPDP (Ley N.° 29733 / D.S. N.° 016-2024-JUS)
PRIVACY_POLICY_VERSION=v1.0-2026
