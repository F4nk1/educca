# ==============================================================================
# Educca Backend - Variables de Entorno de Ejemplo
# Copia este archivo a 'backend/.env' y edita los valores para tu entorno local.
# ==============================================================================

# Configuración del Servidor HTTP
SERVER_PORT=8080

# Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=educca
DB_USER=postgres
DB_PASSWORD=postgres

# Secretos Criptográficos (JWT)
ACCESS_SECRET=super_secret_jwt_access_key_change_in_prod
REFRESH_SECRET=super_secret_jwt_refresh_key_change_in_prod
