# EDUCCA Cusco — Frontend Web Configuration
# URL base de la API REST de Go (producción/pruebas en educca.cocorium.online o http://localhost:8080/api/v1 en local)
VITE_API_BASE_URL=https://educca.cocorium.online/api/v1

# Modo inicial de datos: "api" para backend real Go + PostgreSQL, "demo" para datos simulados
VITE_DEFAULT_DATA_MODE=api
